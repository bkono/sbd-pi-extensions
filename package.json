{
  "name": "@solvedbydev/pi-extensions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsdown -W",
    "build:packages": "tsdown -W -F './packages/*'",
    "build:apps": "tsdown -W -F './apps/*'",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "tsdown -W --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "packages/pi-om-extension/src/index.ts",
      "packages/pi-files-extension/src/index.ts",
      "packages/pi-answer-extension/src/index.ts",
      "packages/pi-beadwork-extension/src/index.ts",
      "packages/pi-exa-extension/src/index.ts",
      "packages/pi-minions/src/index.ts",
      "packages/pi-hashline-readmap/src/index.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "24.12.2",
    "typebox": "1.3.7",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vitest": "4.1.2"
  },
  "overrides": {
    "typebox": "1.3.7"
  }
}
